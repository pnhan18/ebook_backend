# ========================
# BUILD STAGE
# ========================
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

# 1. Cài đặt các gói build cần thiết
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Tạo môi trường ảo (Virtual Environment)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 3. Copy và cài đặt dependencies trước (tận dụng Docker cache)
COPY requirements-books.txt .
RUN pip install --no-cache-dir --upgrade pip wheel \
    && pip install --no-cache-dir -r requirements-books.txt

# 4. Copy source code
COPY prisma ./prisma
COPY src ./src

# 5. Xử lý Prisma: generate và fetch engine
RUN prisma generate \
    && prisma py fetch \
    && find /root/.cache/prisma-python -name "*.gz" -delete 2>/dev/null || true

# ========================
# RUNTIME STAGE
# ========================
FROM python:3.11-slim-bookworm

WORKDIR /app

# 6. Chỉ cài runtime libraries cần thiết
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2 \
    libxslt1.1 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/*

# 7. Copy môi trường ảo từ builder
COPY --from=builder /opt/venv /opt/venv

# 8. Copy Prisma cache
COPY --from=builder /root/.cache/prisma-python /root/.cache/prisma-python

# 9. Copy chỉ source code cần thiết (không copy requirements.txt, etc.)
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src ./src

# 10. Thiết lập môi trường
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV WORKER_TYPE=books

CMD ["celery", "-A", "src.celery_app", "worker", "-Q", "books,audio", "-l", "info", "--pool=gevent", "--concurrency=20"]